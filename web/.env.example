# Server
PORT=3000
NODE_ENV=production

# Installation-defined external identity. The installer generates every blank
# value. Manual deployments must provide a complete, unique set.
INSTANCE_ID=
PUBLIC_API_BASE_PATH=
WEBHOOK_BASE_PATH=
HEALTH_PATH=
API_KEY_PREFIX=
AUTOMATION_NAMESPACE=
SESSION_COOKIE_NAME=
OPERATOR_COOKIE_NAME=
API_DISPLAY_NAME=Private API
# Disabled by default to avoid a shared vendor/version header fingerprint.
API_METADATA_HEADERS_ENABLED=false
API_METADATA_HEADER_PREFIX=

# MySQL (written by installer; or set manually)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Session secret for admin portal cookies (installer generates one)
SESSION_SECRET=
# Independent keys for encrypted integration secrets and forensic integrity.
# Generate unique random values; do not reuse SESSION_SECRET.
SECRET_BOX_KEY=
FORENSIC_KEY=

# Secret control-plane path (installer generates). Never publish this.
# Example: /p/aBcDeFgHiJkLmNoPqRsTuVwXyZ012345
ADMIN_BASE_PATH=

# Only for recovery reinstall (keep false in production)
ALLOW_REINSTALL=false

# Set true when serving over HTTPS (Namecheap SSL)
COOKIE_SECURE=true

# Trust reverse proxy hops (Namecheap shared: 1)
TRUST_PROXY=1

# Browser CORS (Dialer / web apps on another domain)
# Prefer explicit origins:
# CORS_ORIGINS=https://dialer.store.example,https://portal.store.example
CORS_ORIGINS=
# Development only. Production ignores this setting and requires CORS_ORIGINS.
# CORS_ALLOW_ALL=true
CORS_ALLOW_ALL=false

# Optional: restrict admin path to these IPs (comma-separated). Empty = allow any IP that knows the path
ADMIN_IP_ALLOWLIST=

# Public HEALTH_PATH endpoint returns minimal readiness only
HEALTH_PUBLIC=true

# API Sentinel log retention
SENTINEL_RETENTION_DAYS=30
# Root-only HTTP forensic evidence. Evidence is redacted, encrypted, bounded, integrity checked,
# separately retained, and every reveal requires a reason recorded in the access ledger.
SENTINEL_FORENSICS_ENABLED=true
SENTINEL_FORENSIC_RETENTION_DAYS=7
SENTINEL_FORENSIC_MAX_BODY_BYTES=24576

# --- DNCScrub server-side compliance screening ---
# Store the production credential only in the protected .env/hosting secret store.
DNC_SCRUB_KEY=
# Pin the exact DNCScrub project/campaign used for this deployment. Leaving
# these blank uses the provider account default and can apply the wrong rules.
DNC_SCRUB_PROJECT_ID=
DNC_SCRUB_CAMPAIGN_ID=
# OWL sends one POST batch at a time; values are clamped server-side.
DNC_SCRUB_TIMEOUT_MS=30000
DNC_SCRUB_BATCH_SIZE=50
DNC_SCRUB_MAX_RETRIES=2
# Provider limit is 100 POST requests/minute. Default leaves operational headroom.
DNC_SCRUB_REQUESTS_PER_MINUTE=30

# Dialer operator session lifetime in minutes (clamped to 5-480; default 30)
OPERATOR_SESSION_MINUTES=30

# --- Session Harbor (dialer workspace continuity) ---
# White-label CRM *app* origin for contact URL helpers (default same as CRM).
CRM_APP_ORIGIN=
# Max bytes for workspace state JSON (default 256kb)
# WORKSPACE_MAX_BYTES=262144

# --- CRM controlled egress (disabled until explicitly configured) ---
# --- Mandatory admin Google step-up/MFA ---
# Put real values only in the protected production .env or hosting secret store.
# Never commit them or place them in frontend code/localStorage.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://api.store.example/p/YOUR_ADMIN_PATH/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Verified Google emails permitted to complete admin step-up (comma-separated).
GOOGLE_OAUTH_ALLOWED_EMAILS=
# Defaults to true whenever any GOOGLE_OAUTH value is present. Set false only for audited break-glass recovery.
ADMIN_MFA_REQUIRED=true
# Require fresh password + Google verification after this many hours (1-168).
ADMIN_MFA_SESSION_HOURS=12
# Free key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
CENSUS_DATA_YEAR=2024
EAGLE_CAMPAIGN_START_DATE=2020-01-01
EAGLE_COHORT_MATURITY_DAYS=14
EAGLE_VALIDATION_REQUIRED_RUNS=2
EAGLE_FRESHNESS_SLA_HOURS=26
EAGLE_VALIDATION_MAX_AGE_HOURS=72

# --- HAWK isolated custom-code runner (optional) ---
# HAWK never evals JavaScript/Python in the API process. Configure an isolated,
# network-disabled runner only when custom code steps are required.
# HAWK_CODE_RUNNER_URL=https://runner.example.invalid/v1/execute
# HAWK_CODE_RUNNER_TOKEN=
# HAWK_CODE_RUNNER_TIMEOUT_MS=5000

# --- PARROT registered Python bridge ---
# Use the dedicated HTTPS Passenger application. PARROT runs only reviewed,
# registered scripts; it is not the arbitrary HAWK code sandbox.
PARROT_BASE_URL=
PARROT_SERVICE_TOKEN=
PARROT_TIMEOUT_MS=15000
PARROT_MAX_SOURCE_BYTES=65536
# Comma-separated exact hosts or *.example.com patterns available to managed recon helpers.
PARROT_RECON_ALLOWED_HOSTS=
PARROT_RECON_ALLOW_HTTP=false
PARROT_RECON_MAX_BYTES=262144

# --- OSINT Dive Deep v1 manual alpha portal ---
# Disable public registration after the pilot cohort is full.
DIVEDEEP_SIGNUPS_ENABLED=true
# When false, new accounts remain pending for administrator review.
DIVEDEEP_AUTO_APPROVE=false
# Optional shared pilot invitation code. Leave blank to allow open registration.
DIVEDEEP_INVITE_CODE=
# Store encrypted reference images outside the public web root.
DIVEDEEP_PRIVATE_STORAGE_DIR=/home/ACCOUNT/divedeep-private
# Separate customer-site/API deployment. The installer writes both values and
# creates a non-secret divedeep-runtime.js file for the static customer site.
DIVEDEEP_PUBLIC_ORIGIN=
DIVEDEEP_API_ORIGIN=
DIVEDEEP_TERMS_VERSION=divedeep-terms-v2
DIVEDEEP_PRIVACY_VERSION=divedeep-privacy-v2
DIVEDEEP_NOTICE_VERSION=divedeep-notice-at-collection-v1
DIVEDEEP_RESPONSIBLE_DATA_VERSION=divedeep-responsible-data-v1
DIVEDEEP_ELECTRONIC_RECORDS_VERSION=divedeep-electronic-records-v1
DIVEDEEP_AUTHORIZATION_VERSION=divedeep-limited-authorization-v1
DIVEDEEP_AUTHORIZATION_VALIDITY_DAYS=365
DIVEDEEP_LEGAL_ENTITY_NAME=
DIVEDEEP_PRIVACY_CONTACT_EMAIL=
DIVEDEEP_LEGAL_POSTAL_ADDRESS=
# Optional Meta/Facebook connection. Manual profile links work without these values.
DIVEDEEP_META_APP_ID=
DIVEDEEP_META_APP_SECRET=
DIVEDEEP_META_REDIRECT_URI=https://api.divedeep.example/divedeep/connect/facebook/callback
# Pin deliberately to the Graph API version configured in the Meta app.
DIVEDEEP_META_GRAPH_VERSION=
# Requires Meta approval for the user_photos permission before customer albums can be imported.
DIVEDEEP_META_ALBUM_IMPORT=false
DIVEDEEP_META_POST_IMPORT=false
# Uses the Facebook Page → Instagram professional account media path.
DIVEDEEP_META_INSTAGRAM_MEDIA_IMPORT=false

# Segmented DiveDeep import hardening
DIVEDEEP_IMPORT_BATCH_EXPIRY_DAYS=7
DIVEDEEP_STAGED_EVIDENCE_RETENTION_DAYS=30

# Optional database connection isolation. Defaults are safe for small deployments.
# DB_POOL_SIZE=10
# DB_POOL_QUEUE_LIMIT=40
# DB_WORK_POOL_SIZE=2
# DB_WORK_POOL_QUEUE_LIMIT=12
# DB_POOL_IDLE_TIMEOUT_MS=60000
# DB_CONNECT_TIMEOUT_MS=10000


# --- Phase 2 Google Cloud Run Jobs ---
# Cloud Run project, region, Job name, and dispatch state are configured and
# encrypted through DiveDeep Admin -> Integrations and Worker Pools.
# Prefer Application Default Credentials or workload identity. Do not place a
# long-lived service-account JSON document in this file.
# DIVEDEEP_API_ORIGIN above must be reachable by the future worker before dispatch.

# DiveDeep Phase 4 ephemeral worker protocol
# Prefer a distinct random secret. If omitted, the API falls back to SESSION_SECRET.
DIVEDEEP_WORKER_TOKEN_SECRET=
DIVEDEEP_WORKER_BOOTSTRAP_SECONDS=900
DIVEDEEP_WORKER_SESSION_SECONDS=600
DIVEDEEP_WORKER_LEASE_SECONDS=180

# DiveDeep Phase 8 durable CRM queue processing. Disable on replicas dedicated
# exclusively to HTTP ingress when a separate queue processor is scheduled.
DIVEDEEP_CRM_SWEEP_ENABLED=true
DIVEDEEP_CRM_SWEEP_INTERVAL_MS=60000


# DiveDeep Phase 9 signed customer/enterprise webhook delivery. Disable on
# HTTP-only replicas when a dedicated queue processor owns webhook delivery.
DIVEDEEP_WEBHOOK_SWEEP_ENABLED=true
DIVEDEEP_WEBHOOK_SWEEP_INTERVAL_MS=60000

# --- Phase 10 production hardening and environment separation ---
# Use a distinct identity, database, storage namespace, and origins for each environment.
DEPLOYMENT_ENV=production
DIVEDEEP_DEPLOYMENT_ID=
DIVEDEEP_STORAGE_NAMESPACE=
DIVEDEEP_PRIMARY_COMPUTE_PROVIDER=google_cloud_run_jobs
DIVEDEEP_SECONDARY_COMPUTE_PROVIDER=
# Required only in production. This prevents a copied staging configuration from starting as production.
DIVEDEEP_PRODUCTION_ACK=
# Required only while intentionally executing controlled destructive rehearsals.
DIVEDEEP_REHEARSAL_ACK=
DIVEDEEP_PRODUCTION_REHEARSAL_ACK=
# Required for a production migration dry run against a separate shadow database.
DIVEDEEP_MIGRATION_DRY_RUN_ACK=
DIVEDEEP_EXPECTED_WORKER_VERSION=5.29.0
DIVEDEEP_EXPECTED_WORKER_PROTOCOL=divedeep-worker-v1
DIVEDEEP_EXPECTED_FRONTEND_VERSION=1.6.3
