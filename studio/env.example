# Source this file from the same terminal before running ./run.sh.
# Copy it to a private location before adding real provider keys.
export BRAVE_SEARCH_API_KEY=
export URLSCAN_API_KEY=
export WPSCAN_API_TOKEN=

# Most property-source credentials are optional. Census Data API queries use a
# free Census key. Values entered in the
# Property Intel UI are stored locally in property-intel/property-secrets.env.
export OSINT_CENSUS_API_KEY=
export OSINT_NWS_CONTACT=
export OSINT_ARCGIS_TOKEN=
export OSINT_COUNTY_PROPERTY_API_KEY=
export OSINT_PERMIT_API_KEY=
export OSINT_CLERK_API_KEY=

# Optional XDG-compatible local storage overrides.
# export OSINT_STUDIO_DATA_DIR="$HOME/.local/share/osint-dive-deep"
# export OSINT_STUDIO_CACHE_DIR="$HOME/.cache/osint-dive-deep"
# export OSINT_STUDIO_PORT="8501"

# Optional Ubuntu server API and queue. The Ubuntu installer writes these to
# /etc/divedeep/divedeep.env and generates a random API key.
export DIVEDEEP_API_HOST="127.0.0.1"
export DIVEDEEP_API_PORT="8600"
export DIVEDEEP_API_KEY=
export DIVEDEEP_API_DOCS="0"
export DIVEDEEP_API_MAX_BODY_BYTES="10485760"
# export DIVEDEEP_API_DB="$HOME/.local/share/osint-dive-deep/server-jobs.sqlite"
export DIVEDEEP_WORKER_POLL_SECONDS="2"
export DIVEDEEP_STALE_JOB_SECONDS="3600"
export DIVEDEEP_ALLOW_PUBLIC_BIND="0"
