# DiveDeep Ubuntu server environment
HOME=/var/lib/divedeep
PYTHONUNBUFFERED=1
PYTHONUTF8=1

OSINT_STUDIO_DATA_DIR=/var/lib/divedeep/data
OSINT_STUDIO_CACHE_DIR=/var/cache/divedeep
OSINT_STUDIO_PORT=8501
OSINT_RECEIVER_PORT=8765
PLAYWRIGHT_BROWSERS_PATH=/var/cache/divedeep/ms-playwright

DIVEDEEP_API_HOST=127.0.0.1
DIVEDEEP_API_PORT=8600
DIVEDEEP_API_KEY=
DIVEDEEP_API_DOCS=0
DIVEDEEP_API_MAX_BODY_BYTES=10485760
DIVEDEEP_API_DB=/var/lib/divedeep/data/server-jobs.sqlite
DIVEDEEP_WORKER_POLL_SECONDS=2
DIVEDEEP_STALE_JOB_SECONDS=3600

# Keep this at 0 unless the API is protected by Tailscale, a firewall,
# or a TLS reverse proxy with strict access controls.
DIVEDEEP_ALLOW_PUBLIC_BIND=0

# Optional provider keys
BRAVE_SEARCH_API_KEY=
URLSCAN_API_KEY=
WPSCAN_API_TOKEN=
OSINT_CENSUS_API_KEY=
OSINT_NWS_CONTACT=
OSINT_ARCGIS_TOKEN=
OSINT_COUNTY_PROPERTY_API_KEY=
OSINT_PERMIT_API_KEY=
OSINT_CLERK_API_KEY=

# Release management and maintenance state
DIVEDEEP_STATE_FILE=/var/lib/divedeep/data/system-state.json
DIVEDEEP_BACKUP_DIR=/var/lib/divedeep/backups
DIVEDEEP_RELEASE_ROOT=/opt/divedeep/releases
PYTHONDONTWRITEBYTECODE=1
